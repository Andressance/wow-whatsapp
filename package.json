{
  "name": "wow-whatsapp",
  "version": "0.3.0",
  "private": true,
  "description": "Chat with WhatsApp contacts and groups from inside World of Warcraft: Forever, with no UI reloads.",
  "license": "MIT",
  "author": "chelinho139",
  "repository": {
    "type": "git",
    "url": "https://github.com/chelinho139/wow-whatsapp"
  },
  "keywords": [
    "world-of-warcraft",
    "wow-addon",
    "whatsapp",
    "world-of-warcraft",
    "bridge"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "bin": {
    "wow-whatsapp": "bridge/supervisor.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "start": "node bridge/supervisor.js",
    "slots": "node bridge/install-slots.js",
    "test": "node tests/order_check.js && node --test tests/bridge_test.js tests/restore_test.js tests/addon_test.js && node tests/codec_test.js",
    "test:live": "node tests/inject_test.js"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "fengari": "^0.1.4",
    "luaparse": "^0.3.1"
  }
}
